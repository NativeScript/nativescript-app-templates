{
  "compilerOptions": {
    "strict": false,
    "module": "esnext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmitHelpers": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "jsx": "react",
    "lib": ["ESNext", "dom"],
    "paths": {
      "~/*": ["./src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["./src/**/*.tsx?"],
  "files": ["./references.d.ts"],
  "exclude": ["node_modules", "platforms"]
}
